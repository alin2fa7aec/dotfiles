// One vertical bar per monitor, each on the side where the monitors meet.
// This file names no outputs. Each bar includes ~/.config/waybar/output-left.jsonc or output-right.jsonc, which is expected to set "output"
// to that monitor's name, matching the left/right placement in niri's outputs.
// niri's Mod+S sends SIGUSR1 to waybar. Bars other than the right one set on-sigusr1 to noop, so only the right bar is shown or hidden.
// The vertical bars put every module except the power box in modules-left, packed from the top; style.css scatters the boxes left and right and connects them with polylines.
// The power box goes in modules-right at the bottom.
// Box positions and lines assume this order, so update style.css when changing it.
[
  {
    // Left monitor: right edge. The tray can only appear on one bar, so put it on this one, which is never hidden
    "position": "right",
    "width": 52,
    // Always on top. Use overlay to stack above fullscreen windows.
    // Reserve no space; maximized windows extend to the screen edge and the bar sits on top of them
    "layer": "overlay",
    "exclusive": false,
    "on-sigusr1": "noop",
    "modules-left": ["custom/overview", "niri/workspaces", "cpu", "memory", "idle_inhibitor", "pulseaudio", "clock", "custom/notification", "tray"],
    "modules-right": ["custom/power"],
    "include": ["~/.config/waybar/modules.jsonc", "~/.config/waybar/output-left.jsonc"]
  },
  {
    // Right monitor: left edge
    // Hidden normally and shown with Mod+S. While shown, it sits on top of windows, fullscreen included, without moving them
    "position": "left",
    "width": 52,
    "start_hidden": true,
    "layer": "overlay",
    "exclusive": false,
    "modules-left": ["custom/overview", "niri/workspaces", "cpu", "memory", "idle_inhibitor", "pulseaudio", "clock", "custom/notification"],
    "modules-right": ["custom/power"],
    "include": ["~/.config/waybar/modules.jsonc", "~/.config/waybar/output-right.jsonc"]
  }
]
